{
	"name": "benchlog",
	"version": "0.1.0",
	"description": "Board-side UART and firmware-log diagnosis agent. Installs the BenchLog CLI on the published oh-my-pi harness.",
	"keywords": ["benchlog", "uart", "rtt", "agent", "oh-my-pi"],
	"homepage": "https://github.com/liquidsax/BenchLog",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liquidsax/BenchLog.git"
	},
	"bugs": {
		"url": "https://github.com/liquidsax/BenchLog/issues"
	},
	"type": "module",
	"bin": {
		"benchlog": "./bin/benchlog.js"
	},
	"files": [
		"bin/benchlog.js",
		"bin/benchlog-brand.ts",
		"bin/benchlog-startup.yml",
		"benchlog-ext",
		".omp/tools/serial",
		"fixtures",
		"vendor/omitted-optional",
		"scripts/benchlog-serial-demo.ts",
		"scripts/check-install-size.ts",
		"scripts/heavy-optionals.js",
		"scripts/prune-heavy-optionals.js",
		"README.md",
		"BENCHLOG.md",
		"CHANGELOG.md",
		"LICENSE",
		"THIRD-PARTY-NOTICES.txt"
	],
	"scripts": {
		"benchlog": "bun ./bin/benchlog.js",
		"start": "bun ./bin/benchlog.js",
		"demo:fixture": "bun scripts/benchlog-serial-demo.ts --fixture",
		"demo:rtt": "bun scripts/benchlog-serial-demo.ts --rtt",
		"postinstall": "node scripts/prune-heavy-optionals.js",
		"test:serial": "bun test .omp/tools/serial/serial.test.ts bin/benchlog.test.ts scripts/prune-heavy-optionals.test.ts",
		"check:size": "bun scripts/check-install-size.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-coding-agent": "18.10.1"
	},
	"overrides": {
		"@huggingface/transformers": "file:./vendor/omitted-optional",
		"@huggingface/tokenizers": "file:./vendor/omitted-optional",
		"sherpa-onnx": "file:./vendor/omitted-optional",
		"sherpa-onnx-node": "file:./vendor/omitted-optional",
		"sherpa-onnx-linux-x64": "file:./vendor/omitted-optional",
		"sherpa-onnx-linux-arm64": "file:./vendor/omitted-optional",
		"sherpa-onnx-darwin-x64": "file:./vendor/omitted-optional",
		"sherpa-onnx-darwin-arm64": "file:./vendor/omitted-optional",
		"sherpa-onnx-win-x64": "file:./vendor/omitted-optional",
		"sherpa-onnx-win-ia32": "file:./vendor/omitted-optional",
		"onnxruntime-node": "file:./vendor/omitted-optional",
		"onnxruntime-web": "file:./vendor/omitted-optional",
		"onnxruntime-common": "file:./vendor/omitted-optional",
		"fastembed": "file:./vendor/omitted-optional",
		"lucide-react": "file:./vendor/omitted-optional",
		"react": "file:./vendor/omitted-optional",
		"react-dom": "file:./vendor/omitted-optional"
	},
	"engines": {
		"bun": ">=1.3.14"
	}
}
